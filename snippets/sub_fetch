    # Request Clash YAML for new auto and all mihomo subscriptions.
    # Refresh subscriptions that use per-node profiles in the same format.
    kv_var _want "$SUBS/$1/meta" TYPE
    kv_var _previous_fmt "$SUBS/$1/meta" FORMAT
    SUB_PREFER_MIHOMO=0
    case $_want in
        mihomo) SUB_PREFER_MIHOMO=1 ;;
        auto) [ "$_previous_fmt" = links ] || SUB_PREFER_MIHOMO=1 ;;
    esac
    fetch_to "$URL" "$_f" || { URL=; URL_INSECURE=; SUB_PREFER_MIHOMO=0; return 1; }
    SUB_PREFER_MIHOMO=0
