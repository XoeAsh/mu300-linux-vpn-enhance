#!/bin/sh
# Connect LuCI to the active Mihomo or sing-box selector.
set -u
RUN=/run/mu300-vpn
SOCK=$RUN/mihomo-control.sock
STORE=/etc/mu300/vpn
PREF=/root/.mu300-linux-vpn-enhance/selections.json

error() { jq -cn --arg e "$1" '{ok:0,error:$e}'; exit 0; }
identify() {
    PROFILE=$(cat "$STORE/active" 2>/dev/null) || PROFILE=
    PTYPE=
    case "$PROFILE" in ''|*[!a-z0-9-]*) PROFILE=; return 1 ;; esac
    [ -r "$STORE/profiles/$PROFILE/meta" ] || return 1
    PTYPE=$(sed -n "s/^TYPE='\([^']*\)'$/\1/p" "$STORE/profiles/$PROFILE/meta" | head -n 1)
    [ -n "$PTYPE" ]
}
supported() {
    case "$PTYPE" in
        mihomo) [ -r "$STORE/profiles/$PROFILE/config.yaml" ] ;;
        sing-box) [ -r "$STORE/profiles/$PROFILE/config.json" ] ;;
        *) return 1 ;;
    esac
}

has_sing_box_selector() {
    jq -e 'any(.outbounds[]?; .type == "selector" and
        (.tag | type == "string" and length > 0))' "$1" >/dev/null 2>&1
}

kernel_uuid() {
    IFS= read -r uuid < /proc/sys/kernel/random/uuid || return 1
    hex=$(printf '%s' "$uuid" | tr -d '-')
    case "$hex" in ''|*[!0-9a-f]*) return 1 ;; esac
    [ "${#hex}" -eq 32 ] || return 1
    printf '%s' "$hex"
}

prepare_sing_box() (
    run=$1; profile=$2; pid=$3; bin=$4
    has_sing_box_selector "$run/config.json" || exit 1
    umask 077
    tmp=$(mktemp -d "$run/.mu300-vpn-enhance-selector.XXXXXX") || exit 1
    trap 'rm -rf "$tmp"' EXIT
    trap 'exit 1' HUP INT TERM
    port=
    for attempt in 1 2 3 4; do
        random=$(kernel_uuid) || { echo 'sing-box controller could not read kernel randomness' >&2; exit 1; }
        port_seed=$(printf '%.4s' "$random")
        port=$((49152 + 0x$port_seed % 16384))
        hex=$(printf '%04X' "$port")
        if ! awk -v suffix=":$hex" '$4 == "0A" && substr($2,length($2)-4) == suffix {found=1}
            END {exit !found}' /proc/net/tcp /proc/net/tcp6 2>/dev/null; then break; fi
        port=
    done
    [ -n "$port" ] || exit 1
    first=$(kernel_uuid) && second=$(kernel_uuid) || {
        echo 'sing-box controller could not read kernel randomness' >&2; exit 1;
    }
    printf '%s%s' "$first" "$second" > "$tmp/token" || exit 1
    if [ -r "$PREF" ] && jq -e 'type == "array"' "$PREF" >/dev/null 2>&1; then
        cp "$PREF" "$tmp/prefs" || exit 1
    else
        printf '[]\n' > "$tmp/prefs" || exit 1
    fi
    jq --arg profile "$profile" --arg address "127.0.0.1:$port" \
       --rawfile secret "$tmp/token" --slurpfile saved "$tmp/prefs" '
       .outbounds |= map(
           if .type == "selector" then
               . as $group |
               ([$saved[0][] | objects |
                 select(.profile == $profile and .group == $group.tag) | .node | strings] | last) as $node |
               if $node != null and (.outbounds | index($node) != null)
               then .default = $node else . end
           else . end) |
       .experimental = {clash_api: {
           external_controller: $address, secret: $secret,
           access_control_allow_origin: ["http://127.0.0.1"]
       }}' "$run/config.json" > "$tmp/config" || exit 1
    "$bin" check -c "$tmp/config" >/dev/null 2>&1 || {
        echo 'sing-box node controller config did not pass engine validation' >&2
        exit 1
    }
    printf '%s %s\n' "$profile" "$pid" > "$tmp/owner" &&
        mv -f "$tmp/config" "$run/sing-box-controlled.json" &&
        mv -f "$tmp/owner" "$run/sing-box-selector-owner"
)

# Confirm the listener belongs to the service process before sending credentials.
sing_box_controller() {
    IFS=' ' read -r sb_profile sb_pid < "$RUN/sing-box-selector-owner" || return 1
    [ "$sb_profile" = "$PROFILE" ] || return 1
    case "$sb_pid" in ''|0|*[!0-9]*) return 1 ;; esac
    sb_config=$(jq -er '.experimental.clash_api |
        [.external_controller, .secret] | join(" ")' "$RUN/sing-box-controlled.json" 2>/dev/null) || return 1
    sb_addr=${sb_config%% *}; sb_token=${sb_config#* }
    case "$sb_addr" in 127.0.0.1:*) ;; *) return 1 ;; esac
    sb_port=${sb_addr#*:}
    case "$sb_port" in ''|*[!0-9]*) return 1 ;; esac
    [ "$sb_port" -ge 49152 ] && [ "$sb_port" -le 65535 ] || return 1
    case "$sb_token" in ''|*[!0-9a-f]*) return 1 ;; esac
    [ "${#sb_token}" -eq 64 ] || return 1
    sb_hex=$(printf '0100007F:%04X' "$sb_port") || return 1
    sb_inode=$(awk -v addr="$sb_hex" '$2 == addr && $4 == "0A" {print $10; exit}' /proc/net/tcp)
    [ -n "$sb_inode" ] || return 1
    for sb_fd in /proc/"$sb_pid"/fd/*; do
        [ "$(readlink "$sb_fd" 2>/dev/null)" != "socket:[$sb_inode]" ] || return 0
    done
    return 1
}

request() {
    path=$1; shift
    case "$PTYPE" in
        mihomo)
            [ -S "$SOCK" ] || return 1
            curl -q --noproxy '*' --path-as-is --unix-socket "$SOCK" "$@" "http://localhost$path" ;;
        sing-box)
            sing_box_controller 2>/dev/null || return 1
            printf 'header = "Authorization: Bearer %s"\n' "$sb_token" |
                curl -q --noproxy '*' --path-as-is -K - "$@" "http://$sb_addr$path" ;;
        *) return 1 ;;
    esac
}
proxies() {
    request /proxies -fsS --max-time 4 2>/dev/null
}
groups() {
    jq -c '
       if (.proxies|type) != "object" then error("no proxies")
       else [.proxies | to_entries[] |
           select(.value.type == "Selector" and (.value.all|type)=="array") |
           {name:.key,selected:(.value.now//""),
            nodes:[.value.all[]|select(type=="string")]}] | sort_by(.name)
       end'
}
member() {
    printf '%s\n' "$1" | jq -e --arg g "$2" --arg n "$3" \
       'any(.[]; .name==$g and (.nodes|index($n))!=null)' >/dev/null 2>&1
}
switch_one() {
    group=$1; node=$2
    enc=$(jq -rn --arg v "$group" '$v|@uri') || return 1
    payload=$(jq -cn --arg n "$node" '{name:$n}') || return 1
    code=$(request "/proxies/$enc" -sS --max-time 5 -X PUT \
        -H 'Content-Type: application/json' --data "$payload" \
        -o /dev/null -w '%{http_code}' 2>/dev/null) || return 1
    [ "$code" = 204 ] || [ "$code" = 200 ]
}
save_selection() {
    (umask 077
     { [ ! -r "$PREF" ] || cat "$PREF"; [ -r "$PREF" ] || printf '[]\n'; } |
     jq -c --arg p "$PROFILE" --arg g "$1" --arg n "$2" '
         (if type=="array" then . else [] end) |
         map(select(.profile!=$p or .group!=$g)) +
         [{profile:$p,group:$g,node:$n}]' > "$PREF.new.$$") || return 1
    chmod 600 "$PREF.new.$$" && mv -f "$PREF.new.$$" "$PREF"
}
case "${1:-}" in
  get)
    PROFILE=; PTYPE=
    identify || true
    reason=
    if [ "$PTYPE" = sing-box ] && supported &&
       ! has_sing_box_selector "$STORE/profiles/$PROFILE/config.json"; then
        reason=no-selector
    fi
    if [ -z "$reason" ] && supported &&
       data=$(proxies) && list=$(printf '%s\n' "$data" | groups); then
        printf '%s\n' "$list" | jq -c --arg p "$PROFILE" --arg t "$PTYPE" \
            '{ok:1,online:true,profile:$p,type:$t,groups:.}'
    else
        jq -cn --arg p "$PROFILE" --arg t "$PTYPE" --arg r "$reason" \
          '{ok:1,online:false,profile:$p,type:$t,reason:$r,groups:[]}'
    fi
    ;;
  set)
    identify && supported || error 'No active Mihomo or sing-box profile.'
    group=${2:-}; node=${3:-}
    [ -n "$group" ] && [ -n "$node" ] || error 'Choose a proxy group and node.'
    [ "$(printf '%s' "$group" | wc -c)" -le 256 ] && \
    [ "$(printf '%s' "$node" | wc -c)" -le 256 ] || error 'The group or node name is too long.'
    data=$(proxies) && list=$(printf '%s\n' "$data" | groups) || error 'The node controller is unavailable.'
    member "$list" "$group" "$node" || error 'The node does not belong to the selected group.'
    switch_one "$group" "$node" || error 'The proxy engine rejected the node change.'
    save_selection "$group" "$node" || error 'The node switched, but the selection could not be saved.'
    printf '{"ok":1}\n'
    ;;
  restore)
    # Called by the Mihomo driver only during a profile start.
    identify && [ "$PTYPE" = mihomo ] && supported || exit 0
    n=0
    while [ "$n" -lt 6 ]; do
        if data=$(proxies) && list=$(printf '%s\n' "$data" | groups); then break; fi
        n=$((n+1)); sleep 1
    done
    [ "$n" -lt 6 ] || exit 0
    [ -r "$PREF" ] || exit 0
    jq -cr --arg p "$PROFILE" '
       if type=="array" then .[] | select(.profile==$p) | [.group,.node] | @base64
       else empty end' "$PREF" 2>/dev/null |
    while IFS= read -r record; do
        group=$(printf '%s\n' "$record" | jq -Rr '@base64d | fromjson | .[0]') || continue
        node=$(printf '%s\n' "$record" | jq -Rr '@base64d | fromjson | .[1]') || continue
        if member "$list" "$group" "$node"; then
            switch_one "$group" "$node" || true
        fi
    done
    ;;
  prepare-sing-box)
    [ "$#" -eq 5 ] || exit 2
    prepare_sing_box "$2" "$3" "$4" "$5"
    ;;
  in-use)
    PTYPE=mihomo
    if request /proxies -fsS --max-time 2 >/dev/null 2>&1; then exit 0; fi
    [ -r "$RUN/sing-box-selector-owner" ] || exit 1
    IFS=' ' read -r PROFILE _pid < "$RUN/sing-box-selector-owner" || exit 1
    sing_box_controller
    ;;
  *) echo 'usage: selector get | set GROUP NODE | restore' >&2; exit 2 ;;
esac
