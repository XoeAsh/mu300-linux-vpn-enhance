msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Proxy node"
msgstr "Proxy düğümü"

msgid "Selection unavailable"
msgstr "Seçim yapılamıyor"

msgid "Node status is unavailable. Check the LuCI connection."
msgstr "Düğüm durumu alınamadı. LuCI bağlantısını kontrol edin."

msgid "Choose a Mihomo or sing-box profile to select a proxy node."
msgstr "Proxy düğümü seçmek için bir Mihomo veya sing-box profili seçin."

msgid "Node selection is available for Mihomo and sing-box profiles."
msgstr "Düğüm seçimi Mihomo ve sing-box profillerinde kullanılabilir."

msgid "Start the VPN with a profile that has manual proxy groups."
msgstr "VPN'i elle seçim yapılabilen proxy grupları içeren bir profille başlatın."

msgid "This profile has no manual proxy groups."
msgstr "Bu profilde elle seçim yapılabilen proxy grubu yok."

msgid "Proxy group"
msgstr "Proxy grubu"

msgid "Current node: %s"
msgstr "Geçerli düğüm: %s"

msgid "No available nodes"
msgstr "Kullanılabilir düğüm yok"

msgid "Proxy node switched"
msgstr "Proxy düğümü değiştirildi"

msgid "Node changes take effect immediately and are saved for this profile. Traffic rules must use the selected group."
msgstr "Düğüm değişikliği hemen uygulanır ve bu profil için kaydedilir. Trafik kuralları seçilen grubu kullanmalıdır."

msgid "Refresh node status"
msgstr "Düğüm durumunu yenile"

msgid "Proxy node selection"
msgstr "Proxy düğümü seçimi"

msgid "Detect (prefer full configurations)"
msgstr "Otomatik algıla (tam yapılandırmaları tercih et)"

msgid "Full Clash/Mihomo YAML (one profile for all nodes)"
msgstr "Tam Clash/Mihomo YAML (tüm düğümler için tek profil)"

msgid "Automatic detection tries sing-box JSON, then Mihomo YAML, then individual links. Each subscription keeps its detected format on refresh. The URL may contain your account token and is readable only by root."
msgstr "Otomatik algılama sırasıyla sing-box JSON, Mihomo YAML ve ayrı bağlantıları dener. Yenilemede her aboneliğin algılanan biçimi korunur. URL, hesap belirtecinizi içerebilir ve yalnızca root tarafından okunabilir."

msgid "No active Mihomo or sing-box profile."
msgstr "Etkin bir Mihomo veya sing-box profili yok."

msgid "Choose a proxy group and node."
msgstr "Bir proxy grubu ve düğüm seçin."

msgid "The group or node name is too long."
msgstr "Grup veya düğüm adı çok uzun."

msgid "The node controller is unavailable."
msgstr "Düğüm denetleyicisine erişilemiyor."

msgid "The node does not belong to the selected group."
msgstr "Düğüm seçilen gruba ait değil."

msgid "The proxy engine rejected the node change."
msgstr "Proxy motoru düğüm değişikliğini reddetti."

msgid "The node switched, but the selection could not be saved."
msgstr "Düğüm değiştirildi, ancak seçim kaydedilemedi."

msgid "The request is too large."
msgstr "İstek çok büyük."

msgid "Unknown operation."
msgstr "Bilinmeyen işlem."

msgid "Full sing-box JSON (one profile for all nodes)"
msgstr "Tam sing-box JSON (tüm düğümler için tek profil)"
